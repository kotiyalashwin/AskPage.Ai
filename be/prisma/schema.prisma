generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password      String?
  provider      Provider
  platformToken String?  @unique
  planId        String
  usedRequest   Int      @default(0)
  Chats         Chats[]
  URLS          URLS[]
  Plan          Plan     @relation(fields: [planId], references: [id])
}

model Plan {
  id           String   @id
  name         PlanType @unique
  description  String
  price        Int
  totalRequest Int
  features     Json
  User         User[]
}

model URLS {
  id     Int    @id @default(autoincrement())
  url    String
  userId Int
  status Status
  User   User   @relation(fields: [userId], references: [id])
}

model Chats {
  id       Int      @id @default(autoincrement())
  savedAt  DateTime @default(now())
  history  Json
  usermail String
  User     User     @relation(fields: [usermail], references: [email])
}

enum Provider {
  Google
  Credentials
}

enum PlanType {
  Free
  Pro
  Premium
}

enum Status {
  Success
  Failed
}
